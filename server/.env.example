# ── Required ──────────────────────────────────────────────────────────────────

# 'production' | 'development'
NODE_ENV=development

# Port the HTTP server listens on. Use 80 in production (requires CAP_NET_BIND_SERVICE).
PORT=3000

# Directory for SQLite DB, uploaded images, backups, and cached data.
# In production: /var/lib/roomdisplay
DATA_DIR=./data

# SQLite database path (typically inside DATA_DIR).
DATABASE_URL=file:./data/app.db

# Used to sign session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=replace-me-with-32-random-hex-bytes

# Used to encrypt stored calendar credentials (PCO tokens, iCal URLs).
# LOSING THIS MEANS RE-ENTERING ALL CALENDAR SOURCES.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=replace-me-with-32-random-hex-bytes

# ── Optional ──────────────────────────────────────────────────────────────────

# Log level: trace | debug | info | warn | error
LOG_LEVEL=info

# Default time zone for new rooms (IANA format). Can be overridden per room.
DEFAULT_TIMEZONE=America/Chicago

# Flag session cookies as Secure (HTTPS-only). Set to true when running behind
# the Caddy TLS proxy (see deploy/caddy/). Leave false for plain-HTTP LAN access.
# NOTE: the "wake on camera motion" feature needs HTTPS regardless of this flag.
COOKIE_SECURE=false

# Public URL returning { "version": "x.y.z", "commit": "<full-sha>" } JSON.
# When set, the admin dashboard shows an "Update Available" button only when
# the remote commit differs from the running version.
# Recommended: a public GitHub Gist raw URL (no auth required, no credentials).
# Leave unset to disable the update-available indicator entirely.
# VERSION_CHECK_URL=https://gist.githubusercontent.com/YOUR_USER/GIST_ID/raw/version.json
