# Copy to caddy.env and edit. Read by the caddy systemd unit (EnvironmentFile).

# Hostname or LAN IP the tablets use to reach the display.
# A stable hostname is recommended so the cert name matches and doesn't change,
# but a bare IP works too — Caddy's internal CA will include it as an IP SAN.
#   examples:  display.lan   |   roomdisplay.church.local   |   192.168.1.50
RD_HOSTNAME=192.168.1.50

# Port the Node app (roomdisplay.service) listens on.
# MUST match PORT in the app's .env. With Caddy in front, the app no longer
# needs port 80 — use a non-privileged port like 3000.
RD_BACKEND_PORT=3000
